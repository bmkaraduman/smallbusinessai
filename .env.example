# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Nothing here is needed for the demo —
# the dashboard runs entirely on lib/mock-data.ts until these are wired up.
# ---------------------------------------------------------------------------

# Anthropic — review replies, social captions, weekly reports
ANTHROPIC_API_KEY=

# Google Business Profile API (OAuth2)
# Console: https://console.cloud.google.com  → Anmeldedaten → OAuth-Client-ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Meta — WhatsApp Business Cloud API + Graph API (Instagram/Facebook)
# https://developers.facebook.com/documentation/business-messaging/whatsapp/get-started
META_APP_ID=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Supabase — database + auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis — BullMQ job queue (2-hourly review scan, Monday report)
REDIS_URL=

# Payments
MOLLIE_API_KEY=
STRIPE_SECRET_KEY=

# Open data
KNMI_API_KEY=
